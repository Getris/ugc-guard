{
  "name": "@zooplio/ugc-guard",
  "version": "0.1.0",
  "description": "A lightweight, configurable TypeScript toolkit for inspecting user-generated content.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/adapters/express.d.ts",
      "import": "./dist/adapters/express.js"
    },
    "./fastify": {
      "types": "./dist/adapters/fastify.d.ts",
      "import": "./dist/adapters/fastify.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test",
    "prepack": "npm run check",
    "prepare": "npm run build"
  },
  "keywords": [
    "ugc",
    "moderation",
    "security",
    "spam",
    "unicode",
    "content-filter",
    "typescript"
  ],
  "author": "Zooplio contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zooplio/ugc-guard.git"
  },
  "bugs": {
    "url": "https://github.com/zooplio/ugc-guard/issues"
  },
  "homepage": "https://github.com/zooplio/ugc-guard#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
